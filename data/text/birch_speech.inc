gText_Birch_Welcome::
	.string "Ola! Bem-vindo a ERYON!\p"
	.string "Meu nome e ELYA.\p"
	.string "Sou professora e pesquiso\n"
	.string "os misterios desta regiao.\p"
	.string "Eryon precisa de novos\n"
	.string "treinadores corajosos.\p"
	.string "$"

gText_Birch_Pokemon::
	.string "Estas criaturas sao POKéMON.\p"
	.string "$"

gText_Birch_MainSpeech::
	.string "POKéMON e pessoas convivem\n"
	.string "nesta regiao de cristais.\p"
	.string "A Equipe Eclipse procura\n"
	.string "um poder perigoso.\p"
	.string "Sua jornada comecara\n"
	.string "em Vila Aurora.\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "E voce, jovem treinador?$"

gText_Birch_BoyOrGirl::
	.string "Voce quer jogar como\n"
	.string "garoto ou garota?$"

gText_Birch_WhatsYourName::
	.string "Muito bem!\n"
	.string "Qual e o seu nome?$"

gText_Birch_SoItsPlayer::
	.string "Seu nome e {PLAYER}, certo?$"

gText_Birch_YourePlayer::
	.string "Entendi! Voce e {PLAYER}.\p"
	.string "A jornada comeca\n"
	.string "na Vila Aurora!\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "Esta tudo pronto, {PLAYER}?\p"
	.string "Seu primeiro POKéMON sera\n"
	.string "o leal RIOLU.\p"
	.string "Explore Eryon, ganhe\n"
	.string "insignias e descubra\n"
	.string "os misterios dos cristais!\p"
	.string "Venha ao meu laboratorio\n"
	.string "na Vila Aurora.\p"
	.string "$"
